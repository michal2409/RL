+def _dsa_indexer_chunk_size(seqlen_q: int) -> int:
+    """Query-dimension chunk size for the DSA indexer score computation.
+
+    The naive indexer materializes the full ``[seqlen_q, batch, index_n_heads, seqlen_k]``
+    score tensor (O(seqlen^2 * index_n_heads), fp32). At SWE-length sequences this is tens
+    of GiB and OOMs. Chunking the query dimension caps the peak at
+    ``[chunk, batch, index_n_heads, seqlen_k]`` while keeping the math identical (the
+    head-sum and top-k are per-query-row, so query chunks are independent).
+
+    Controlled by ``MCORE_DSA_INDEXER_CHUNK_SIZE`` (number of query positions per chunk).
+    ``0`` (or a value >= seqlen_q) disables chunking and recovers the original single-pass
+    computation.
+    """
+    try:
+        chunk = int(os.environ.get("MCORE_DSA_INDEXER_CHUNK_SIZE", "1024"))
+    except ValueError:
+        chunk = 1024
+    if chunk <= 0 or chunk >= seqlen_q:
+        return seqlen_q
+    return chunk
+
